# CHECKMYPC — production environment
# Copy to your host (Vercel project settings or a local .env that is never committed).
# Never prefix secrets with VITE_.

# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS, …)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/checkmypc?sslmode=require

# HMAC secret for admin session cookies. Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset, the app generates and stores one in the database.
AUTH_SECRET=

# Optional bootstrap for the first operator. If both are unset, create the
# first admin at /admin/login (Create admin account).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site URL (sitemap, canonical links). Example: https://checkmypc.ma
SITE_URL=https://checkmypc.ma

# Optional: Vercel Blob token. When unset, inspection photos are stored in Postgres.
# BLOB_READ_WRITE_TOKEN=

# Optional. Leave unset unless you explicitly enable Grok Better Auth customer accounts.
# VITE_AUTH_ENABLED=false
